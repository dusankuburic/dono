@inherits LayoutComponentBase
@inject IBuildingService BuildingService
@inject IBuildingSelectionService BuildingSelection
@inject IAuthService AuthService
@inject INotificationService NotificationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h5" Class="ml-3">Building Manager</MudText>

        @if (_buildings.Count > 0)
        {
            <MudSelect T="string"
                       Value="@_selectedBuildingId"
                       ValueChanged="@OnBuildingChanged"
                       Label="Building"
                       Variant="Variant.Text"
                       Dense="true"
                       Class="ml-6"
                       Style="max-width: 240px; padding-top: 4px;">
                @foreach (var building in _buildings)
                {
                    <MudSelectItem Value="@building.Id">@building.Name</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudBadge Badge="@_unreadNotifications" Color="Color.Error" Max="9" Overlap="true"
                          Visible="@(_unreadNotifications > 0)" Class="mr-2">
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit"
                                   Title="Notifications" Href="/notifications" />
                </MudBadge>
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-2" />
                <MudText Typo="Typo.body2" Class="mr-2">@context.User.Identity?.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Password" Color="Color.Inherit" Title="Change password"
                               Href="/account/password" />
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Edge="Edge.End" Title="Sign out"
                               OnClick="Logout" />
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login"
                           Href="/login">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/buildings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Apartment">Buildings</MudNavLink>
            <MudNavLink Href="/residents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Residents</MudNavLink>
            <MudNavLink Href="/workorders" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Build">Work Orders</MudNavLink>
            <MudNavLink Href="/keys" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.VpnKey">Keys</MudNavLink>
            <MudNavLink Href="/finance" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AttachMoney">Finance</MudNavLink>
            <MudNavLink Href="/assemblies" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HowToVote">Assemblies</MudNavLink>
            <MudNavLink Href="/announcements" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Campaign">Announcements</MudNavLink>
            <MudNavLink Href="/documents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FolderOpen">Documents</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pt-16 px-4">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider? _mudThemeProvider;
    private bool _isDarkMode;
    private bool _drawerOpen = true;
    private List<BuildingSummary> _buildings = new();
    private string? _selectedBuildingId;
    private int _unreadNotifications;
    private PeriodicTimer? _notificationTimer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _buildings = await BuildingService.GetBuildingsAsync();
            _selectedBuildingId = await BuildingSelection.GetSelectedBuildingIdAsync();
        }
        catch
        {
            // The API is unreachable; the selector stays hidden and pages show
            // their own error state.
        }

        // The bell's unread badge: check right away, then once a minute. Skips
        // the API call while signed out and ignores errors (the badge is not
        // worth failing anything over).
        _notificationTimer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        _ = PollNotificationsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _mudThemeProvider != null)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemPreference();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PollNotificationsAsync()
    {
        await RefreshUnreadCountAsync();
        while (_notificationTimer is not null && await _notificationTimer.WaitForNextTickAsync())
        {
            await RefreshUnreadCountAsync();
        }
    }

    private async Task RefreshUnreadCountAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated != true)
            {
                SetUnread(0);
                return;
            }

            SetUnread(await NotificationService.GetUnreadCountAsync());
        }
        catch
        {
            // Signed out (refresh failed) or API down: keep the last badge.
        }
    }

    private void SetUnread(int count)
    {
        if (_unreadNotifications == count)
            return;
        _unreadNotifications = count;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnBuildingChanged(string? buildingId)
    {
        if (string.IsNullOrEmpty(buildingId) || buildingId == _selectedBuildingId)
        {
            return;
        }

        await BuildingSelection.SetSelectedBuildingIdAsync(buildingId);
        // Pages cache data for the selected building; reload to re-query them.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("login", forceLoad: true);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
