@page "/reset-password"
@inject IAuthService AuthService

<PageTitle>Reset password</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-16">
    <MudPaper Class="pa-6" Elevation="4">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5" Align="Align.Center">Reset your password</MudText>

            @if (_done)
            {
                <MudAlert Severity="Severity.Success">
                    Your password has been reset and all your devices have been signed out.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/login">
                    Sign in
                </MudButton>
            }
            else
            {
                <MudTextField @bind-Value="_email" Label="Email" Required="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                <MudTextField @bind-Value="_token" Label="Reset code" Required="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Key" />
                <MudTextField @bind-Value="_password" Label="New password (min. 8 characters)" InputType="InputType.Password" Required="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock" />
                <MudTextField @bind-Value="_confirmPassword" Label="Confirm new password" InputType="InputType.Password" Required="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                              Error="@(_password != _confirmPassword)" ErrorText="Passwords do not match" />

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           OnClick="Submit" Disabled="@_busy">
                    @(_busy ? "Resetting..." : "Reset password")
                </MudButton>

                <MudText Typo="Typo.body2">
                    No code? <MudLink Href="/forgot-password">Request a new one</MudLink>
                </MudText>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? EmailQuery { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenQuery { get; set; }

    private string _email = string.Empty;
    private string _token = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _done;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(EmailQuery) && string.IsNullOrEmpty(_email))
        {
            _email = EmailQuery;
        }

        if (!string.IsNullOrWhiteSpace(TokenQuery) && string.IsNullOrEmpty(_token))
        {
            _token = TokenQuery;
        }
    }

    private async Task Submit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_email)
            || string.IsNullOrWhiteSpace(_token)
            || _password.Length < 8
            || _password != _confirmPassword)
        {
            _error = "Please fill in all fields (password at least 8 characters, matching confirmation).";
            return;
        }

        _busy = true;
        try
        {
            await AuthService.ResetPasswordAsync(_email.Trim(), _token.Trim(), _password);
            _done = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
