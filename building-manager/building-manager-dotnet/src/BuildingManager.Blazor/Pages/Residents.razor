@page "/residents"
@inject IBuildingService BuildingService
@inject IBuildingSelectionService BuildingSelection
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Residents</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h3">Residents</MudText>
    @if (_canManage && _editing is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="StartAdd">
            Add resident
        </MudButton>
    }
</MudStack>

@if (_noBuildings)
{
    <MudAlert Severity="Severity.Info">
        No buildings yet. <MudLink Href="/buildings/new">Create a building</MudLink> first.
    </MudAlert>
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
}
else
{
    @if (_canManage && _editing is not null)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="4">
            <MudText Typo="Typo.h6" Class="mb-2">@(_residentId is null ? "Add resident" : "Edit resident")</MudText>
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_firstName" Label="First name" MaxLength="100" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_lastName" Label="Last name" MaxLength="100" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="string" @bind-Value="_unitNumber" Label="Unit" Clearable="true">
                        @foreach (var unit in _units)
                        {
                            <MudSelectItem Value="@unit.Number">@unit.Number</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="ResidentRole" @bind-Value="_role" Label="Role">
                        @foreach (var role in Enum.GetValues<ResidentRole>())
                        {
                            <MudSelectItem Value="@role">@BuildingLabels.ResidentRoleLabel(role)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_phone" Label="Phone" MaxLength="30" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_email" Label="Email (matches the resident's account)" MaxLength="200" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudNumericField T="decimal?" @bind-Value="_ownershipShare" Label="Share %" Min="0" Max="100" />
                </MudItem>
            </MudGrid>
            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_formError</MudAlert>
            }
            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="SaveResident">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@_busy" OnClick="@(() => _editing = null)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
    }

    <MudTextField @bind-Value="_search" Label="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" Class="mb-2" Style="max-width: 380px;" />

    <MudTable Items="@FilteredResidents" Hover="true" Stripable="true" Breakpoint="Breakpoint.Sm" Loading="@_loading">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Unit</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Share</MudTh>
            @if (_canManage)
            {
                <MudTh></MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.FirstName @context.LastName</MudTd>
            <MudTd DataLabel="Unit">@(context.UnitNumber ?? "-")</MudTd>
            <MudTd DataLabel="Role">
                <MudChip Size="Size.Small">@BuildingLabels.ResidentRoleLabel(context.Role)</MudChip>
            </MudTd>
            <MudTd DataLabel="Phone">
                @if (!string.IsNullOrEmpty(context.Phone))
                {
                    <MudLink Href="@($"tel:{context.Phone}")">@context.Phone</MudLink>
                }
                else
                {
                    @("-")
                }
            </MudTd>
            <MudTd DataLabel="Email">@(context.Email ?? "-")</MudTd>
            <MudTd DataLabel="Share">@(context.OwnershipShare?.ToString("N2") ?? "-")%</MudTd>
            @if (_canManage)
            {
                <MudTd Style="text-align: right; white-space: nowrap;">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_busy"
                               OnClick="@(() => StartEdit(context))">Edit</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="@_busy"
                               OnClick="@(() => Remove(context))">Remove</MudButton>
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudTd Colspan="@(_canManage ? 7 : 6)" Class="pa-4" Align="Align.Center">
                @(string.IsNullOrWhiteSpace(_search) ? "No active residents." : "No residents match the search.")
            </MudTd>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private string? _buildingId;
    private bool _noBuildings;
    private bool _canManage;
    private List<ResidentInfo> _residents = new();
    private List<UnitInfo> _units = new();
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _loadError;
    private string _search = string.Empty;

    private bool? _editing;
    private Guid? _residentId;
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string? _unitNumber;
    private ResidentRole _role = ResidentRole.Owner;
    private string? _phone;
    private string? _email;
    private decimal? _ownershipShare;
    private string? _formError;

    private List<ResidentInfo> FilteredResidents
    {
        get
        {
            var search = _search.Trim();
            if (search.Length == 0)
            {
                return _residents;
            }

            return _residents.Where(r =>
                r.FirstName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                r.LastName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                (r.UnitNumber?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Phone?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Email?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
        }
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            _canManage = UserRoles.CanManage((await AuthState).User);
        }

        _buildingId = await BuildingSelection.GetSelectedBuildingIdAsync();
        if (_buildingId is null)
        {
            _noBuildings = true;
            _loading = false;
            return;
        }

        try
        {
            _residents = (await BuildingService.GetResidentsAsync(_buildingId)).ToList();
            _units = (await BuildingService.GetUnitsAsync(_buildingId)).ToList();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load residents: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void StartAdd()
    {
        _editing = true;
        _residentId = null;
        _firstName = _lastName = string.Empty;
        _unitNumber = null;
        _role = ResidentRole.Owner;
        _phone = _email = null;
        _ownershipShare = null;
        _formError = null;
    }

    private void StartEdit(ResidentInfo resident)
    {
        _editing = true;
        _residentId = resident.Id;
        _firstName = resident.FirstName;
        _lastName = resident.LastName;
        _unitNumber = resident.UnitNumber;
        _role = resident.Role;
        _phone = resident.Phone;
        _email = resident.Email;
        _ownershipShare = resident.OwnershipShare;
        _formError = null;
    }

    private async Task SaveResident()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            _formError = "Enter the resident's first and last name.";
            return;
        }

        var request = new ResidentInfoRequest
        {
            FirstName = _firstName.Trim(),
            LastName = _lastName.Trim(),
            UnitNumber = string.IsNullOrWhiteSpace(_unitNumber) ? null : _unitNumber,
            Role = _role,
            Phone = string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim(),
            Email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
            OwnershipShare = _ownershipShare
        };

        _busy = true;
        try
        {
            if (_residentId is { } id)
            {
                await BuildingService.UpdateResidentAsync(_buildingId!, id, request);
                Snackbar.Add("Resident saved", Severity.Success);
            }
            else
            {
                await BuildingService.AddResidentAsync(_buildingId!, request);
                Snackbar.Add("Resident added", Severity.Success);
            }

            _editing = null;
            _residents = (await BuildingService.GetResidentsAsync(_buildingId!)).ToList();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Remove(ResidentInfo resident)
    {
        if (await DialogService.ShowMessageBox("Remove resident",
                $"Remove {resident.FirstName} {resident.LastName} from the building? The record is kept in history.",
                yesText: "Remove", cancelText: "Back") == true)
        {
            _busy = true;
            _error = null;
            try
            {
                await BuildingService.RemoveResidentAsync(_buildingId!, resident.Id);
                Snackbar.Add("Resident removed", Severity.Success);
                _residents = (await BuildingService.GetResidentsAsync(_buildingId!)).ToList();
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
            finally
            {
                _busy = false;
            }
        }
    }
}
