@page "/residents"
@inject IBuildingService BuildingService
@inject IBuildingSelectionService BuildingSelection
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Residents</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h3">Residents</MudText>
    @if (_canManage && _buildingId is not null && _form is null && _loadError is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => StartForm(null))">
            Add resident
        </MudButton>
    }
</MudStack>

@if (_noBuildings)
{
    <MudAlert Severity="Severity.Info">
        No buildings yet. <MudLink Href="/buildings/new">Create a building</MudLink> first.
    </MudAlert>
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
}
else
{
    @if (_form is not null)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-2">@(_form.Id is null ? "New resident" : $"{_form.FirstName} {_form.LastName}")</MudText>
            @if (_units.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    This building has no units yet. <MudLink Href="@($"/buildings/{_buildingId}")">Add units</MudLink> to register residents at them.
                </MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_form.FirstName" Label="First name" MaxLength="100" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_form.LastName" Label="Last name" MaxLength="100" Immediate="true" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="string" @bind-Value="_form.UnitNumber" Label="Unit" Clearable="true">
                        @foreach (var unit in _units)
                        {
                            <MudSelectItem Value="@unit.Number">@unit.Number (floor @unit.Floor)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="ResidentRole" @bind-Value="_form.Role" Label="Role">
                        @foreach (var role in Enum.GetValues<ResidentRole>())
                        {
                            <MudSelectItem Value="@role">@BuildingLabels.ResidentRole(role)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudTextField @bind-Value="_form.Phone" Label="Phone" MaxLength="30" InputType="InputType.Telephone" />
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="_form.Email" Label="Email" MaxLength="200" InputType="InputType.Email"
                                  HelperText="Owners who sign in with this email see their unit's fees" />
                </MudItem>
                @if (_form.Role is ResidentRole.Owner or ResidentRole.CoOwner)
                {
                    <MudItem xs="12" sm="6" md="3">
                        <MudNumericField T="decimal?" @bind-Value="_form.OwnershipShare" Label="Share of the unit owned (%)" Min="0" Max="100"
                                         HelperText="Leave empty for a sole owner" />
                    </MudItem>
                }
            </MudGrid>
            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_formError</MudAlert>
            }
            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="Save">Save</MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@_busy" OnClick="@(() => { _form = null; _formError = null; })">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="mb-2" Style="flex-wrap: wrap;">
        <MudTextField @bind-Value="_search" Placeholder="Search name, unit, phone or email" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Style="min-width: 280px;" />
        <MudSelect T="ResidentRole?" @bind-Value="_roleFilter" Label="Role" Clearable="true" Style="max-width: 200px;">
            @foreach (var role in Enum.GetValues<ResidentRole>())
            {
                <MudSelectItem T="ResidentRole?" Value="@role">@BuildingLabels.ResidentRole(role)</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Filtered.Count() of @_residents.Count</MudText>
    </MudStack>

    <MudTable Items="@Filtered" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm" Loading="@_loading">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Unit</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Email</MudTh>
            @if (_canManage)
            {
                <MudTh></MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.FirstName @context.LastName</MudTd>
            <MudTd DataLabel="Unit">@(context.UnitNumber ?? "-")</MudTd>
            <MudTd DataLabel="Role">
                <MudChip Size="Size.Small">
                    @BuildingLabels.ResidentRole(context.Role)@(context.OwnershipShare is { } share ? $" · {share:0.##}%" : "")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Phone">
                @if (context.Phone is not null)
                {
                    <MudLink Href="@TelLink(context.Phone)">@context.Phone</MudLink>
                }
                else
                {
                    <span>-</span>
                }
            </MudTd>
            <MudTd DataLabel="Email">
                @if (context.Email is not null)
                {
                    <MudLink Href="@($"mailto:{context.Email}")">@context.Email</MudLink>
                }
                else
                {
                    <span>-</span>
                }
            </MudTd>
            @if (_canManage)
            {
                <MudTd Style="text-align: right; white-space: nowrap;">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit" Disabled="@_busy"
                                   OnClick="@(() => StartForm(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Color="Color.Error" Title="Move out" Disabled="@_busy"
                                   OnClick="@(() => MoveOut(context))" />
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudTd Colspan="6" Class="pa-4" Align="Align.Center">
                @(_residents.Count == 0 ? "No active residents." : "Nobody matches the search.")
            </MudTd>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private string? _buildingId;
    private List<ResidentInfo> _residents = new();
    private List<UnitInfo> _units = new();
    private bool _loading = true;
    private bool _noBuildings;
    private string? _loadError;
    private bool _canManage;
    private bool _busy;

    private string? _search;
    private ResidentRole? _roleFilter;

    private ResidentForm? _form;
    private string? _formError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private sealed class ResidentForm
    {
        public Guid? Id { get; init; }
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string? UnitNumber { get; set; }
        public ResidentRole Role { get; set; } = ResidentRole.Owner;
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public decimal? OwnershipShare { get; set; }
    }

    private IEnumerable<ResidentInfo> Filtered => _residents
        .Where(r => _roleFilter is null || r.Role == _roleFilter)
        .Where(r => string.IsNullOrWhiteSpace(_search) || Matches(r, _search.Trim()));

    private static bool Matches(ResidentInfo r, string term) =>
        $"{r.FirstName} {r.LastName}".Contains(term, StringComparison.OrdinalIgnoreCase) ||
        (r.UnitNumber?.Equals(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
        PhoneMatches(r.Phone, term) ||
        (r.Email?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false);

    private static bool PhoneMatches(string? phone, string term)
    {
        var digits = new string(term.Where(char.IsDigit).ToArray()).TrimStart('0');
        return phone is not null && digits.Length >= 3 &&
               new string(phone.Where(char.IsDigit).ToArray()).Contains(digits);
    }

    private static string TelLink(string phone) => "tel:" + new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray());

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            _canManage = UserRoles.CanManage((await AuthState).User);
        }

        try
        {
            _buildingId = await BuildingSelection.GetSelectedBuildingIdAsync();
            if (_buildingId is null)
            {
                _noBuildings = true;
                return;
            }

            await Load();
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load residents: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Load()
    {
        _residents = (await BuildingService.GetResidentsAsync(_buildingId!))
            .OrderBy(r => r.UnitNumber is null)
            .ThenBy(r => r.UnitNumber?.Length).ThenBy(r => r.UnitNumber)
            .ThenBy(r => r.LastName)
            .ToList();
        _units = (await BuildingService.GetUnitsAsync(_buildingId!)).ToList();
    }

    private void StartForm(ResidentInfo? resident)
    {
        _formError = null;
        _form = resident is null
            ? new ResidentForm()
            : new ResidentForm
            {
                Id = resident.Id,
                FirstName = resident.FirstName,
                LastName = resident.LastName,
                UnitNumber = resident.UnitNumber,
                Role = resident.Role,
                Phone = resident.Phone,
                Email = resident.Email,
                OwnershipShare = resident.OwnershipShare
            };
    }

    private async Task Save()
    {
        if (_form is null || _buildingId is null)
            return;
        if (string.IsNullOrWhiteSpace(_form.FirstName) || string.IsNullOrWhiteSpace(_form.LastName))
        {
            _formError = "Enter the first and last name.";
            return;
        }

        var request = new ResidentInfoRequest
        {
            FirstName = _form.FirstName.Trim(),
            LastName = _form.LastName.Trim(),
            UnitNumber = _form.UnitNumber,
            Role = _form.Role,
            Phone = string.IsNullOrWhiteSpace(_form.Phone) ? null : _form.Phone.Trim(),
            Email = string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email.Trim(),
            OwnershipShare = _form.Role is ResidentRole.Owner or ResidentRole.CoOwner ? _form.OwnershipShare : null
        };

        _busy = true;
        _formError = null;
        try
        {
            if (_form.Id is { } id)
                await BuildingService.UpdateResidentAsync(_buildingId, id, request);
            else
                await BuildingService.AddResidentAsync(_buildingId, request);

            Snackbar.Add($"{request.FirstName} {request.LastName} saved", Severity.Success);
            _form = null;
            await Load();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MoveOut(ResidentInfo resident)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Move out",
            $"Mark {resident.FirstName} {resident.LastName} as moved out? They leave the directory but stay on record.",
            yesText: "Move out", cancelText: "Cancel");
        if (confirmed != true || _buildingId is null)
            return;

        _busy = true;
        try
        {
            await BuildingService.MoveOutResidentAsync(_buildingId, resident.Id);
            Snackbar.Add($"{resident.FirstName} {resident.LastName} moved out", Severity.Info);
            await Load();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
