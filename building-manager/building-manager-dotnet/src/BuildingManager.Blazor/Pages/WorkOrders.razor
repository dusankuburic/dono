@page "/workorders"
@inject IBuildingService BuildingService
@inject IBuildingSelectionService BuildingSelection
@inject ISnackbar Snackbar

<PageTitle>Work Orders</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h3">Work Orders</MudText>
    @if (_buildingId is not null && _report is null && _loadError is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ReportProblem" OnClick="StartReport">
            Report a problem
        </MudButton>
    }
</MudStack>

@if (_noBuildings)
{
    <MudAlert Severity="Severity.Info">
        No buildings yet. <MudLink Href="/buildings/new">Create a building</MudLink> first.
    </MudAlert>
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
}
else
{
    @if (_report is not null)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-2">Report a problem</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_report.Title" Label="What is wrong?" MaxLength="200" Immediate="true"
                                  Placeholder="e.g. Elevator stuck on the 3rd floor" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="WorkOrderCategory" @bind-Value="_report.Category" Label="Category">
                        @foreach (var category in Enum.GetValues<WorkOrderCategory>())
                        {
                            <MudSelectItem Value="@category">@BuildingLabels.Category(category)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="string" @bind-Value="_report.UnitNumber" Label="Unit (optional)" Clearable="true">
                        @foreach (var unit in _units)
                        {
                            <MudSelectItem Value="@unit.Number">@unit.Number</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_report.Description" Label="Details" Lines="4" MaxLength="2000" Counter="2000"
                                  Variant="Variant.Outlined" Immediate="true"
                                  Placeholder="Where exactly, since when, anything already tried" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="Priority" @bind-Value="_report.Priority" Label="Urgency">
                        @foreach (var priority in Enum.GetValues<Priority>())
                        {
                            <MudSelectItem Value="@priority">@BuildingLabels.Priority(priority).Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (_canManage && _residents.Count > 0)
                {
                    <MudItem xs="12" md="5">
                        <MudSelect T="Guid" @bind-Value="_report.ReportedById" Label="Reported by"
                                   ToStringFunc="@ReporterText">
                            <MudSelectItem Value="@Guid.Empty">Me</MudSelectItem>
                            @foreach (var resident in _residents)
                            {
                                <MudSelectItem Value="@resident.Id">@ReporterText(resident.Id)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
            @if (_report.Priority == Priority.Emergency)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                    Emergencies (flooding, gas, no power, people stuck) start the 48-hour intervention deadline.
                    If anyone is in danger, call 112 first.
                </MudAlert>
            }
            @if (_reportError is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_reportError</MudAlert>
            }
            <MudStack Row="true" Spacing="2" Class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="SubmitReport">Send report</MudButton>
                <MudButton Variant="Variant.Outlined" Disabled="@_busy" OnClick="@(() => { _report = null; _reportError = null; })">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_selected is not null)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2" Style="@(_selected.IsEmergency && BuildingLabels.IsOpen(_selected.Status) ? "border-left: 4px solid var(--mud-palette-error);" : "")">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                <div>
                    <MudText Typo="Typo.caption" Class="d-block" Color="Color.Secondary">@_selected.ReferenceNumber</MudText>
                    <MudText Typo="Typo.h6">@_selected.Title</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Title="Close" OnClick="@(() => _selected = null)" />
            </MudStack>

            <MudStack Row="true" Spacing="1" Class="my-2" Style="flex-wrap: wrap;">
                <MudChip Size="Size.Small" Color="@BuildingLabels.WorkOrderStatus(_selected.Status).Color">@BuildingLabels.WorkOrderStatus(_selected.Status).Text</MudChip>
                <MudChip Size="Size.Small" Color="@BuildingLabels.Priority(_selected.Priority).Color">@BuildingLabels.Priority(_selected.Priority).Text</MudChip>
                <MudChip Size="Size.Small">@BuildingLabels.Category(_selected.Category)</MudChip>
                @if (_selected.UnitNumber is not null)
                {
                    <MudChip Size="Size.Small">Unit @_selected.UnitNumber</MudChip>
                }
            </MudStack>

            @if (EmergencyText(_selected) is { } emergency)
            {
                <MudAlert Severity="@(emergency.Overdue ? Severity.Error : Severity.Warning)" Dense="true" Class="mb-2">@emergency.Text</MudAlert>
            }

            <MudText Typo="Typo.body2" Class="mb-1">
                Reported @Local(_selected.CreatedAt)@(_selected.ReportedByName is null ? "" : $" by {_selected.ReportedByName}")
                @if (_selected.CompletedAt is { } completed)
                {
                    <span> · completed @Local(completed)</span>
                }
            </MudText>
            @if (!string.IsNullOrWhiteSpace(_selected.Description))
            {
                <MudText Typo="Typo.body1" Class="mb-3" Style="white-space: pre-line;">@_selected.Description</MudText>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-2">History</MudText>
            @if (_selected.Notes.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No updates yet.</MudText>
            }
            else
            {
                @foreach (var note in _selected.Notes)
                {
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Class="my-1">
                        <MudText Typo="Typo.caption" Class="d-block" Color="Color.Secondary" Style="min-width: 120px;">@Local(note.At)</MudText>
                        <div>
                            @if (note.Status is { } status)
                            {
                                <MudChip Size="Size.Small" Color="@BuildingLabels.WorkOrderStatus(status).Color">@BuildingLabels.WorkOrderStatus(status).Text</MudChip>
                            }
                            @if (note.Text is not null)
                            {
                                <span style="white-space: pre-line;">@note.Text</span>
                            }
                            @if (note.AuthorName is not null)
                            {
                                <MudText Typo="Typo.caption" Class="d-block" Color="Color.Secondary">@note.AuthorName</MudText>
                            }
                        </div>
                    </MudStack>
                }
            }

            @if (_canManage && BuildingLabels.IsOpen(_selected.Status))
            {
                <MudDivider Class="my-3" />
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSelect T="WorkOrderStatus" @bind-Value="_newStatus" Label="Status">
                            @foreach (var status in Enum.GetValues<WorkOrderStatus>())
                            {
                                <MudSelectItem Value="@status">@BuildingLabels.WorkOrderStatus(status).Text</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudTextField @bind-Value="_note" Label="Note for residents (optional)" MaxLength="1000" Immediate="true"
                                      Placeholder="e.g. Plumber booked for Thursday morning" />
                    </MudItem>
                </MudGrid>
                @if (_newStatus is WorkOrderStatus.Completed or WorkOrderStatus.Cancelled)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">A completed or cancelled work order can't be changed afterwards.</MudAlert>
                }
                @if (_updateError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_updateError</MudAlert>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Disabled="@(_busy || !HasUpdate)" OnClick="SaveUpdate">
                    @(_newStatus == _selected.Status ? "Add note" : "Update")
                </MudButton>
            }
        </MudPaper>
    }

    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="mb-2">
        <MudSelect T="string" Value="_filter" ValueChanged="SetFilter" Label="Show" Style="max-width: 240px;">
            <MudSelectItem Value="@("open")">Open</MudSelectItem>
            <MudSelectItem Value="@("all")">All</MudSelectItem>
            @foreach (var status in Enum.GetValues<WorkOrderStatus>())
            {
                <MudSelectItem Value="@status.ToString()">@BuildingLabels.WorkOrderStatus(status).Text</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Filtered.Count() work order(s)</MudText>
    </MudStack>

    <MudTable T="WorkOrderInfo" Items="@Filtered" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading"
              OnRowClick="@(args => Select(args.Item))" RowStyleFunc="@RowStyle">
        <HeaderContent>
            <MudTh>Reference</MudTh>
            <MudTh>Problem</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Urgency</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Reported</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Reference">@context.ReferenceNumber</MudTd>
            <MudTd DataLabel="Problem">
                @context.Title
                @if (context.UnitNumber is not null)
                {
                    <MudText Typo="Typo.caption" Class="d-block" Color="Color.Secondary">Unit @context.UnitNumber</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Category">@BuildingLabels.Category(context.Category)</MudTd>
            <MudTd DataLabel="Urgency">
                <MudChip Size="Size.Small" Color="@BuildingLabels.Priority(context.Priority).Color">@BuildingLabels.Priority(context.Priority).Text</MudChip>
                @if (EmergencyText(context) is { } emergency)
                {
                    <MudText Typo="Typo.caption" Class="d-block" Color="@(emergency.Overdue ? Color.Error : Color.Warning)">@emergency.Short</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip Size="Size.Small" Color="@BuildingLabels.WorkOrderStatus(context.Status).Color">@BuildingLabels.WorkOrderStatus(context.Status).Text</MudChip>
            </MudTd>
            <MudTd DataLabel="Reported">
                @context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                @if (context.ReportedByName is not null)
                {
                    <MudText Typo="Typo.caption" Class="d-block" Color="Color.Secondary">@context.ReportedByName</MudText>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudTd Colspan="6" Class="pa-4" Align="Align.Center">
                @(_workOrders.Count == 0 ? "No problems reported yet." : "No work orders match this filter.")
            </MudTd>
        </NoRecordsContent>
    </MudTable>
}

@code {
    private string? _buildingId;
    private bool _noBuildings;
    private string? _loadError;
    private bool _loading = true;
    private bool _canManage;
    private bool _busy;
    private List<WorkOrderInfo> _workOrders = new();
    private List<UnitInfo> _units = new();
    private List<ResidentInfo> _residents = new();
    private string _filter = "open";

    private ReportForm? _report;
    private string? _reportError;

    private WorkOrderInfo? _selected;
    private WorkOrderStatus _newStatus;
    private string? _note;
    private string? _updateError;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private sealed class ReportForm
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public WorkOrderCategory Category { get; set; } = WorkOrderCategory.Other;
        public Priority Priority { get; set; } = Priority.Normal;
        public string? UnitNumber { get; set; }
        public Guid ReportedById { get; set; }
    }

    private string ReporterText(Guid id) =>
        _residents.FirstOrDefault(r => r.Id == id) is { } r
            ? $"{r.FirstName} {r.LastName}" + (r.UnitNumber is null ? "" : $" (unit {r.UnitNumber})")
            : "Me";

    private IEnumerable<WorkOrderInfo> Filtered => _filter switch
    {
        "all" => _workOrders,
        "open" => _workOrders.Where(w => BuildingLabels.IsOpen(w.Status)),
        _ => Enum.TryParse<WorkOrderStatus>(_filter, out var status) ? _workOrders.Where(w => w.Status == status) : _workOrders
    };

    private bool HasUpdate => _selected is not null && (_newStatus != _selected.Status || !string.IsNullOrWhiteSpace(_note));

    private static string Local(DateTime utc) => utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static (string Text, string Short, bool Overdue)? EmergencyText(WorkOrderInfo w)
    {
        if (!w.IsEmergency || w.EmergencyDeadline is not { } deadline || !BuildingLabels.IsOpen(w.Status))
            return null;

        var overdue = deadline < DateTime.UtcNow;
        var relative = BuildingLabels.Relative(deadline);
        return overdue
            ? ($"The 48-hour intervention deadline passed {relative} ({Local(deadline)}).", $"48 h passed {relative}", true)
            : ($"Emergency: intervention required by {Local(deadline)} ({relative}).", $"due {relative}", false);
    }

    private string RowStyle(WorkOrderInfo w, int index) =>
        (w.Id == _selected?.Id ? "background-color: var(--mud-palette-action-default-hover);" : "") +
        (w.IsEmergency && BuildingLabels.IsOpen(w.Status) ? "border-left: 4px solid var(--mud-palette-error);" : "") +
        "cursor: pointer;";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            _canManage = UserRoles.CanManage((await AuthState).User);
        }

        try
        {
            _buildingId = await BuildingSelection.GetSelectedBuildingIdAsync();
            if (_buildingId is null)
            {
                _noBuildings = true;
                return;
            }

            await LoadWorkOrders();
            _units = (await BuildingService.GetUnitsAsync(_buildingId)).ToList();
            if (_canManage)
            {
                _residents = (await BuildingService.GetResidentsAsync(_buildingId))
                    .OrderBy(r => r.LastName).ThenBy(r => r.FirstName).ToList();
            }
        }
        catch (Exception ex)
        {
            _loadError = $"Could not load work orders: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadWorkOrders()
    {
        _workOrders = (await BuildingService.GetWorkOrdersAsync(_buildingId!)).ToList();
        if (_selected is not null)
        {
            _selected = _workOrders.FirstOrDefault(w => w.Id == _selected.Id);
        }
    }

    private void SetFilter(string filter) => _filter = filter;

    private void Select(WorkOrderInfo workOrder)
    {
        _selected = workOrder;
        _newStatus = workOrder.Status;
        _note = null;
        _updateError = null;
    }

    private void StartReport()
    {
        _report = new ReportForm();
        _reportError = null;
    }

    private async Task SubmitReport()
    {
        if (_report is null || _buildingId is null)
            return;
        if (string.IsNullOrWhiteSpace(_report.Title))
        {
            _reportError = "Describe the problem in a few words.";
            return;
        }

        _busy = true;
        _reportError = null;
        try
        {
            var created = await BuildingService.CreateWorkOrderAsync(_buildingId, new CreateWorkOrderRequest
            {
                Title = _report.Title.Trim(),
                Description = _report.Description.Trim(),
                Category = _report.Category,
                Priority = _report.Priority,
                UnitNumber = _report.UnitNumber,
                ReportedByResidentId = _report.ReportedById,
                IsEmergency = _report.Priority == Priority.Emergency
            });
            Snackbar.Add($"Reported as {created.ReferenceNumber}", Severity.Success);
            _report = null;
            await LoadWorkOrders();
            Select(_workOrders.FirstOrDefault(w => w.Id == created.Id) ?? created);
        }
        catch (Exception ex)
        {
            _reportError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveUpdate()
    {
        if (_selected is null || _buildingId is null)
            return;

        _busy = true;
        _updateError = null;
        try
        {
            var updated = await BuildingService.UpdateWorkOrderStatusAsync(
                _buildingId, _selected.Id, _newStatus, string.IsNullOrWhiteSpace(_note) ? null : _note.Trim());
            Snackbar.Add($"{updated.ReferenceNumber} updated", Severity.Success);
            await LoadWorkOrders();
            Select(_workOrders.FirstOrDefault(w => w.Id == updated.Id) ?? updated);
        }
        catch (Exception ex)
        {
            _updateError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
