@page "/forgot-password"
@inject IAuthService AuthService

<PageTitle>Forgot password</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-16">
    <MudPaper Class="pa-6" Elevation="4">
        <MudStack Spacing="4" AlignItems="AlignItems.Center">
            <MudText H5="true" Align="Align.Center">Forgot your password?</MudText>

            @if (_sent)
            {
                <MudAlert Severity="Severity.Success">
                    If an account exists for @_email, a reset code has been sent to it. The code is valid for 1 hour.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           Href="@($"/reset-password?email={Uri.EscapeDataString(_email.Trim())}")">
                    Enter reset code
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body2" Align="Align.Center">
                    Enter your account email and we'll send you a code to reset your password.
                </MudText>

                <MudTextField @bind-Value="_email" Label="Email" Required="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"
                              ImmediateError="true" ErrorText="Email is required"
                              Error="@(_showErrors && string.IsNullOrWhiteSpace(_email))" />

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large"
                           OnClick="Submit" Disabled="@_busy">
                    @(_busy ? "Sending..." : "Send reset code")
                </MudButton>
            }

            <MudText Typo="Typo.body2">
                <MudLink Href="/login">Back to sign in</MudLink>
            </MudText>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string _email = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _showErrors;
    private bool _sent;

    private async Task Submit()
    {
        _showErrors = true;
        if (string.IsNullOrWhiteSpace(_email))
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await AuthService.ForgotPasswordAsync(_email.Trim());
            _sent = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
