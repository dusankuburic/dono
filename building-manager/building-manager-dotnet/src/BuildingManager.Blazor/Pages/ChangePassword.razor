@page "/account/password"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Change password</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-8">
            <MudPaper Class="pa-6" Elevation="2">
                <MudStack Spacing="4">
                    <MudText H5="true">Change password</MudText>
                    <MudText Typo="Typo.body2">
                        Changing your password signs you out on every device, including this one.
                    </MudText>

                    <MudTextField @bind-Value="_currentPassword" Label="Current password" InputType="InputType.Password" Required="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock" />
                    <MudTextField @bind-Value="_newPassword" Label="New password (min. 8 characters)" InputType="InputType.Password" Required="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockReset" />
                    <MudTextField @bind-Value="_confirmPassword" Label="Confirm new password" InputType="InputType.Password" Required="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockReset"
                                  Error="@(_newPassword != _confirmPassword)" ErrorText="Passwords do not match" />

                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                    }

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@_busy">
                        @(_busy ? "Changing..." : "Change password")
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudContainer>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task Submit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_currentPassword)
            || _newPassword.Length < 8
            || _newPassword != _confirmPassword)
        {
            _error = "Please fill in all fields (new password at least 8 characters, matching confirmation).";
            return;
        }

        _busy = true;
        try
        {
            await AuthService.ChangePasswordAsync(_currentPassword, _newPassword);
            // Every session was revoked server-side, including this one.
            Navigation.NavigateTo("login", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
