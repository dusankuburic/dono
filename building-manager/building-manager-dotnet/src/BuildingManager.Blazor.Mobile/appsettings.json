{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "ApiBaseUrl": "https://api.buildingmanager.example.com",
  "LocalStorage": {
    "Key": "building-manager-mobile-state",
    "SyncIntervalSeconds": 60
  },
  "Offline": {
    "Enabled": true,
    "MaxOfflineDays": 7,
    "SyncOnReconnect": true
  },
  "PushNotifications": {
    "Enabled": true
  }
}
