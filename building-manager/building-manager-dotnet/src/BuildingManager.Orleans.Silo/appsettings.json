{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting": "Information",
        "Orleans": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Orleans": {
    "ClusterId": "building-manager-dev",
    "ServiceId": "building-manager-service",
    "AdvertisedIPAddress": "127.0.0.1",
    "GatewayPort": 30000,
    "SiloPort": 11111,
    "DashboardPort": 8081
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=building_manager;Username=postgres;Password=postgres",
    "OrleansStorage": "Host=localhost;Port=5432;Database=building_manager_orleans;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Storage": {
    "BlobConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "building-documents"
  },
  "ApplicationInsights": {
    "InstrumentationKey": ""
  }
}
