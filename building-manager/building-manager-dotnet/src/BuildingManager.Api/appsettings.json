{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting": "Information",
        "Orleans": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Orleans": {
    "ClusterId": "building-manager-dev",
    "ServiceId": "building-manager-service",
    "GatewayPort": 30000
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7071",
      "http://localhost:7071",
      "https://localhost:5002",
      "http://localhost:5002"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=building_manager;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyForDevelopmentOnly123!",
    "Issuer": "building-manager",
    "Audience": "building-manager-api",
    "ExpirationMinutes": 60
  },
  "Storage": {
    "BlobConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "building-documents"
  },
  "ApplicationInsights": {
    "InstrumentationKey": ""
  },
  "AllowedHosts": "*"
}
